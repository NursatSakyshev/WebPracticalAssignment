{
  "info": {
    "name": "Space Bounty Hunters API",
    "description": "Start the API with `docker compose up --build`, then run the whole collection in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "huntId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Criminals",
      "item": [
        {
          "name": "List all criminals",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('At least 5 criminals', () => pm.expect(list.length).to.be.at.least(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter + sort (min_reward, armed, -reward)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Filters work together', () => list.forEach((c) => {",
                  "  pm.expect(c.reward).to.be.at.least(5000);",
                  "  pm.expect(c.armed).to.eql(true);",
                  "}));",
                  "pm.test('Sorted by reward descending', () => {",
                  "  for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].reward).to.be.at.least(list[i].reward);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by max_reward, has_crew, escape_master",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.response.json().forEach((c) => pm.test(`${c.nickname} matches filters`, () => {",
                  "  pm.expect(c.reward).to.be.at.most(10000);",
                  "  pm.expect(c.has_crew).to.eql(true);",
                  "  pm.expect(c.escape_master).to.eql(true);",
                  "}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?max_reward=10000&has_crew=true&escape_master=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "max_reward",
                  "value": "10000"
                },
                {
                  "key": "has_crew",
                  "value": "true"
                },
                {
                  "key": "escape_master",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Sort by reward ascending",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Sorted by reward ascending', () => {",
                  "  for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].reward).to.be.at.most(list[i].reward);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?sort=reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "reward"
                }
              ]
            }
          }
        },
        {
          "name": "Get criminal details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('Returns criminal 1 with hunt logs', () => {",
                  "  pm.expect(c.id).to.eql(1);",
                  "  pm.expect(c.hunts).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                "1",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Hunt logs",
      "item": [
        {
          "name": "List all hunt logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('At least 10 hunt logs', () => pm.expect(pm.response.json().length).to.be.at.least(10));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            }
          }
        },
        {
          "name": "Filter hunt logs by criminal_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Only logs of criminal 1', () => pm.response.json().forEach((h) => pm.expect(h.criminal_id).to.eql(1)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/?criminal_id=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ],
              "query": [
                {
                  "key": "criminal_id",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Create hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.test('Server generated id and created_at', () => {",
                  "  pm.expect(h.id).to.be.a('number');",
                  "  pm.expect(new Date(h.created_at).toString()).to.not.eql('Invalid Date');",
                  "});",
                  "pm.collectionVariables.set('huntId', h.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}"
            }
          }
        },
        {
          "name": "Get hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the created log', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('huntId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Update hunt log (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const h = pm.response.json();",
                  "pm.test('success and notes updated', () => {",
                  "  pm.expect(h.success).to.eql(true);",
                  "  pm.expect(h.notes).to.eql('Caught her on the second try.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"notes\": \"Caught her on the second try.\"\n}"
            }
          }
        },
        {
          "name": "Delete hunt log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Get deleted hunt log (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/{{huntId}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "{{huntId}}",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Invalid requests",
      "item": [
        {
          "name": "Criminal not found (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/9999/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                "9999",
                ""
              ]
            }
          }
        },
        {
          "name": "Invalid criminal id (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/abc/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                "abc",
                ""
              ]
            }
          }
        },
        {
          "name": "Invalid filters (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=lots&armed=maybe&sort=name",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "lots"
                },
                {
                  "key": "armed",
                  "value": "maybe"
                },
                {
                  "key": "sort",
                  "value": "name"
                }
              ]
            }
          }
        },
        {
          "name": "Create hunt for non-existent criminal (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Explains the problem', () => pm.expect(pm.response.json().details[0]).to.include('does not exist'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 9999,\n  \"success\": false,\n  \"notes\": \"Who is this?\"\n}"
            }
          }
        },
        {
          "name": "Create hunt with client created_at and bad data (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('created_at is rejected', () => pm.expect(pm.response.json().details).to.include('created_at is generated by the server and cannot be set'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 1,\n  \"success\": \"maybe\",\n  \"created_at\": \"2020-01-01T00:00:00Z\"\n}"
            }
          }
        },
        {
          "name": "Change criminal_id with PATCH (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/1/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                "1",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 2\n}"
            }
          }
        }
      ]
    }
  ]
}